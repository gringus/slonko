[Unit]
Description=TP-Link Tapo P110 and Tapo H200 Prometheus exporter written in Go
Documentation=https://github.com/tess1o/go-tapo-exporter
After=network-online.target

[Service]
User=go-tapo-exporter
Restart=on-failure
EnvironmentFile=/etc/conf.d/go-tapo-exporter
ExecStart=/usr/bin/go-tapo-exporter $command_args
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=20s
SendSIGKILL=no

[Install]
WantedBy=multi-user.target
