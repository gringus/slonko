<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM "https://www.gentoo.org/dtd/metadata.dtd">
<pkgmetadata>
	<maintainer type="person">
		<email>marcin.deranek@slonko.net</email>
		<name>Marcin Deranek</name>
	</maintainer>
	<upstream>
		<bugs-to>https://github.com/lexiforest/curl-impersonate/issues</bugs-to>
		<remote-id type="github">lexiforest/curl-impersonate</remote-id>
	</upstream>
	<use>
		<flag name="clients">Install the curl wrapper scripts</flag>
		<flag name="gopher">Enable Gopher protocol support</flag>
		<flag name="idn">Enable internationalized domain names via net-dns/libidn2</flag>
		<flag name="kerberos">Enable HTTP GSS-API/Negotiate authentication</flag>
		<flag name="pop3">Enable Post Office Protocol 3 support</flag>
		<flag name="sasl-scram">Enable SCRAM-SHA-1/-256 authentication via net-misc/gsasl</flag>
		<flag name="smtp">Enable Simple Mail Transfer Protocol support</flag>
		<flag name="telnet">Enable Telnet protocol support</flag>
		<flag name="tftp">Enable TFTP support</flag>
	</use>
</pkgmetadata>
